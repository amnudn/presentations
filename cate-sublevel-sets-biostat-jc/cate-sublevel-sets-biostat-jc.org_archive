#+BEGIN_SRC R :results silent
  library(data.table)
  library(here)
  setwd(here("cate-sublevel-sets-biostat-jc"))

  n <- 100000
  dd <- data.table(Age = rnorm(n),
		   FEV = runif(n),
		   Sex = 1*(runif(n)<0.3))

  ## Some functions we use
  expit <- function(x) 1/(1+exp(-x))
  calc_ate_levels <- function(ites, aa = seq(-1, 1, length = 2000)){
    ites = sort(ites)
    ff = sapply(aa, function(a) mean(ites < a))
    data.table(effect = aa, prop = ff)
  }
  make_gamma_plot <- function(ites, aa = seq(-1, 1, length = 2000)){
    ites = sort(ites)
    ff = sapply(aa, function(a) mean(ites < a))
    plot(aa, ff, type = "l", xlab = expression("Effect size " * (alpha)), ylab = expression("Size of levels set " * (gamma)), lwd = 2)
    abline(v = mean(ites), col = "blue", lty = 1, lwd = 1)
    text(x = mean(ites), y = .9, labels = "ATE", pos = 2, col = "blue")
  }

  dd[, ite1 := expit(.1*Age+Age*1+Sex+0.4*1) - expit(.1*Age+Sex)]
  dd[, ite2 := expit(.1*Age-2*Age*1+Sex+2*Sex*1+0.4*1) - expit(.1*Age+Sex)]
  dd[, ite3 := expit(0.5*Age+Sex+1) - expit(0.5*Age+Sex)]
  dd[, ite4 := expit(0*Age+Sex+1) - expit(0*Age+Sex)]
#+END_SRC

